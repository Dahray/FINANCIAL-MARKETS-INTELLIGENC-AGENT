# ==============================================================================
# SOHCAHTOA FINANCIAL MARKETS INTELLIGENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and populate with your credentials.
# NEVER commit `.env` to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SECURITY
# ------------------------------------------------------------------------------
APP_NAME="Financial Markets Intelligence Platform"
APP_ENV=development                       # development | staging | production
APP_DEBUG=false
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Cryptographic secret key (generate via: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_CRYPTOGRAPHIC_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Initial Admin Bootstrap Account (used by db seed script only if no admin exists)
INITIAL_ADMIN_EMAIL=admin@sohcahtoaholdings.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
INITIAL_ADMIN_ROLE=EXECUTIVE_ADMIN

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AGENT_TRIGGER_RATE_LIMIT_PER_HOUR=20

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16 + TimescaleDB + pgvector) & REDIS
# ------------------------------------------------------------------------------
POSTGRES_USER=fmip_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=fmip_intelligence
POSTGRES_HOST=localhost                   # Use 'db' inside Docker Compose network
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fmip_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/fmip_intelligence

REDIS_HOST=localhost                      # Use 'redis' inside Docker Compose network
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. AI & MULTI-AGENT ORCHESTRATION (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Primary reasoning model for Chief Research Editor, Strategic, Macro, Investment Agents
GEMINI_PRIMARY_MODEL=gemini-2.5-pro
# Fast extraction & classification model for ingestion and triage
GEMINI_FAST_MODEL=gemini-2.5-flash
# Embedding model for pgvector semantic search (768 dimensions)
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------------------------
# 4. FINANCIAL DATA & RESEARCH PROVIDERS
# ------------------------------------------------------------------------------
# Search & Intelligence APIs
TAVILY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Global & Macro Financial Data APIs
FMP_API_KEY=                              # Financial Modeling Prep API Key
ALPHA_VANTAGE_API_KEY=                    # Alpha Vantage API Key
FRED_API_KEY=                             # Federal Reserve Economic Data (St. Louis Fed) API Key

# Official Nigerian Financial Market & Regulatory Sources (Public RSS/REST/Scraper Endpoints)
CBN_BASE_URL=https://www.cbn.gov.ng
NGX_BASE_URL=https://ngxgroup.com
FMDQ_BASE_URL=https://fmdqgroup.com
DMO_BASE_URL=https://www.dmo.gov.ng
NBS_BASE_URL=https://nigerianstat.gov.ng
SEC_NIGERIA_BASE_URL=https://sec.gov.ng
PENCOM_BASE_URL=https://www.pencom.gov.ng
NAICOM_BASE_URL=https://naicom.gov.ng

# HTTP Client Timeout & User-Agent for Official Regulatory Scrapers
DATA_PROVIDER_TIMEOUT_SECONDS=30
DATA_PROVIDER_MAX_RETRIES=3
DATA_PROVIDER_USER_AGENT="FMIP-Institutional-Research-Engine/1.0 (+https://sohcahtoaholdings.com)"

# ------------------------------------------------------------------------------
# 5. REPORTING, GOOGLE DRIVE ARCHIVING & GMAIL DELIVERY
# ------------------------------------------------------------------------------
REPORT_STORAGE_DIR=./storage/reports
DEFAULT_REPORT_DAY_OF_WEEK=FRI            # Weekly report execution day (Friday)
DEFAULT_REPORT_TIME_WAT=16:30             # 4:30 PM West Africa Time (after NGX & FMDQ market close)
DEFAULT_TIMEZONE=Africa/Lagos

# Google Drive API Integration (Service Account JSON path)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google_service_account.json
GOOGLE_DRIVE_REPORTS_FOLDER_ID=

# Email / Gmail Delivery Configuration
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_APP_PASSWORD=                        # 16-character Google App Password (or OAuth2 token)
EMAIL_FROM_ADDRESS=research-desk@sohcahtoaholdings.com
EMAIL_FROM_NAME="SohCahToa Financial Markets Intelligence Desk"
WEEKLY_REPORT_RECIPIENTS=exco@sohcahtoaholdings.com,cio@sohcahtoaholdings.com

# ------------------------------------------------------------------------------
# 6. n8n WORKFLOW AUTOMATION
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY
N8N_WEBHOOK_SHARED_SECRET=CHANGE_ME_N8N_WEBHOOK_SHARED_SECRET
