{
  "name": "06 - FMIP Quarterly Financial Market Outlook & Strategic Review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 1 1,4,7,10 *"
            }
          ]
        }
      },
      "id": "cron-quarterly-outlook",
      "name": "Quarterly Outlook Trigger (Jan/Apr/Jul/Oct 17:00 WAT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FMIP_BACKEND_URL || 'http://host.docker.internal:8000' }}/api/v1/webhooks/n8n/quarterly-outlook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SHARED_SECRET || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 240000
        }
      },
      "id": "http-quarterly-outlook",
      "name": "Run Quarterly Outlook, Stress Test & Strategic Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        540,
        300
      ]
    }
  ],
  "connections": {
    "Quarterly Outlook Trigger (Jan/Apr/Jul/Oct 17:00 WAT)": {
      "main": [
        [
          {
            "node": "Run Quarterly Outlook, Stress Test & Strategic Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Lagos"
  }
}
