{
  "name": "02 - FMIP Regulatory & Competitor Intelligence Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule-regulatory-6h",
      "name": "Every 6 Hours Regulatory Poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FMIP_BACKEND_URL || 'http://host.docker.internal:8000' }}/api/v1/webhooks/n8n/regulatory-monitor",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SHARED_SECRET || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "http-regulatory-monitor",
      "name": "Poll CBN, SEC Nigeria, PenCom, NAICOM & DMO",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Every 6 Hours Regulatory Poll": {
      "main": [
        [
          {
            "node": "Poll CBN, SEC Nigeria, PenCom, NAICOM & DMO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Lagos"
  }
}
