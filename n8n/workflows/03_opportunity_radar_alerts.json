{
  "name": "03 - FMIP Continuous Opportunity Radar Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-radar-daily",
      "name": "Daily 17:00 WAT Opportunity Scan",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/webhooks/n8n/opportunity-alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SHARED_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "id": "http-opportunity-alerts",
      "name": "Evaluate High-Conviction Opportunities (>= Threshold)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Daily 17:00 WAT Opportunity Scan": {
      "main": [
        [
          {
            "node": "Evaluate High-Conviction Opportunities (>= Threshold)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Lagos"
  }
}
