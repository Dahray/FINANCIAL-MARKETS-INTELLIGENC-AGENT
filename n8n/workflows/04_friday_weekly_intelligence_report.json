{
  "name": "04 - FMIP Friday Weekly 16-Section Report, PDF/Excel, Drive & Gmail Delivery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 16 * * 5"
            }
          ]
        }
      },
      "id": "schedule-friday-report",
      "name": "Every Friday 16:30 WAT (After NGX & FMDQ Close)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FMIP_BACKEND_URL || 'http://host.docker.internal:8000' }}/api/v1/webhooks/n8n/friday-weekly-report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SHARED_SECRET || '' }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "http-friday-pipeline",
      "name": "Run 8 Agents -> Generate PDF & Excel -> Archive to Drive -> Send Gmail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    }
  ],
  "connections": {
    "Every Friday 16:30 WAT (After NGX & FMDQ Close)": {
      "main": [
        [
          {
            "node": "Run 8 Agents -> Generate PDF & Excel -> Archive to Drive -> Send Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Lagos"
  }
}
